{
  "name": "@termweave/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-beta.73",
      "@effect/openapi-generator": "4.0.0-beta.73",
      "@effect/platform-node": "4.0.0-beta.73",
      "@effect/sql-sqlite-bun": "4.0.0-beta.73",
      "@effect/vitest": "4.0.0-beta.73",
      "@effect/language-service": "0.75.1",
      "@pierre/diffs": "1.1.20",
      "@types/bun": "^1.3.9",
      "@types/node": "^24.10.13",
      "tsdown": "^0.20.3",
      "typescript": "~6.0.3",
      "vitest": "^4.0.0",
      "@effect/tsgo": "0.11.4",
      "@effect/platform-bun": "4.0.0-beta.73",
      "@effect/platform-node-shared": "4.0.0-beta.73",
      "@typescript/native-preview": "7.0.0-dev.20260527.2"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "dev": "turbo run dev --filter=termweave-server --filter=termweave --parallel",
    "dev:server": "turbo run dev --filter=termweave-server",
    "dev:tui": "node scripts/dev-tui.ts",
    "dev:tui:headless": "T3CODE_HEADLESS=1 bun run apps/tui/src/index.tsx",
    "start": "turbo run start --filter=termweave-server",
    "start:tui": "turbo run start --filter=termweave",
    "build": "turbo run build",
    "build:tui": "turbo run build --filter=termweave",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "turbo run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:contracts": "turbo run build --filter=@termweave/contracts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist .turbo apps/*/.turbo"
  },
  "dependencies": {
    "@openai/codex": "^0.136.0"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "turbo": "^2.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vite": "^8.0.0"
  },
  "engines": {
    "bun": "^1.3.9",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.3.9"
}
