{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "T3CODE_LOG_WS_EVENTS",
    "T3CODE_PORT",
    "T3CODE_HOME",
    "T3CODE_CONFIG_HOME",
    "T3CODE_AUTH_TOKEN",
    "T3CODE_HOST",
    "T3CODE_TUI_ATTACH_ONLY",
    "T3CODE_HEADLESS",
    "T3CODE_HEADLESS_FRAME_PATH",
    "T3CODE_HEADLESS_TIMEOUT_MS",
    "T3CODE_HEADLESS_WIDTH",
    "T3CODE_HEADLESS_HEIGHT",
    "APP_VERSION"
  ],
  "globalPassThroughEnv": ["PATHEXT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "dependsOn": ["@termweave/contracts#build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
