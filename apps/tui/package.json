{
  "name": "termweave",
  "version": "0.0.24",
  "description": "Terminal-first coding-agent client with an OpenTUI client",
  "homepage": "https://github.com/RicardoVcore/termweave#readme",
  "bugs": {
    "url": "https://github.com/RicardoVcore/termweave/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RicardoVcore/termweave.git",
    "directory": "apps/tui"
  },
  "bin": {
    "termweave": "./bin/termweave.js"
  },
  "files": [
    "README.md",
    "bin",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "dev:headless": "T1CODE_HEADLESS=1 bun run src/index.tsx",
    "build": "bun run scripts/build-runtime.mjs && node scripts/bundle-server-dist.mjs",
    "prepack": "bun run build && node scripts/prepare-package-json.mjs",
    "postpack": "node scripts/restore-package-json.mjs",
    "start": "bun dist/index.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opentui/core": "^0.2.7",
    "@opentui/react": "^0.2.7",
    "effect": "catalog:",
    "react": "^19.0.0",
    "react-devtools-core": "^7.0.1",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@termweave/client-core": "workspace:*",
    "@termweave/contracts": "workspace:*",
    "@termweave/shared": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "termweave-server": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.2.7",
    "@opentui/core-darwin-x64": "0.2.7",
    "@opentui/core-linux-arm64": "0.2.7",
    "@opentui/core-linux-x64": "0.2.7",
    "@opentui/core-win32-arm64": "0.2.7",
    "@opentui/core-win32-x64": "0.2.7"
  },
  "engines": {
    "bun": ">=1.3.9",
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
